{
  "name": "munchkin-tracker",
  "private": true,
  "description": "Real-time Munchkin level tracker: Go server, shared core, Expo app (iOS/Android/web)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "app": "npm run start -w @munchkin/app",
    "app:web": "npm run web -w @munchkin/app"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
